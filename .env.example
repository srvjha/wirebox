# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (docker compose up -d db) ---
DATABASE_URL=postgres://wirebox:wirebox@localhost:5433/wirebox

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Optional OAuth providers. Leave blank to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# One-click "Continue as guest" sign-in for testing. On in development by default;
# set true to allow it in production, false to hide it everywhere.
GUEST_LOGIN=
# Comma-separated emails that can open /admin (user counts, sign-ups)
ADMIN_EMAILS=

# --- PostHog (leave blank to disable analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ASSETS_HOST=https://us-assets.i.posthog.com

# --- AI drill debriefs (optional; falls back to built-in feedback) ---
# Set any ONE key. AI_PROVIDER picks one explicitly (anthropic | openai | gemini);
# when blank, the first provider with a key is used.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Any OpenAI-compatible API works too (OpenRouter, Groq, Together, Ollama...)
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
