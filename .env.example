# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (docker compose up -d db) ---
DATABASE_URL=postgres://wirebox:wirebox@localhost:5433/wirebox

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Optional OAuth providers. Leave blank to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated emails that can open /admin (user counts, sign-ups)
ADMIN_EMAILS=

# --- PostHog (leave blank to disable analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ASSETS_HOST=https://us-assets.i.posthog.com

# --- AI lab debriefs (optional; falls back to built-in feedback) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
