# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase: database and auth ---
# Local: `pnpm db:up` starts Supabase in Docker; these are its fixed local defaults.
# Production: Project Settings > Data API (URL), API Keys (publishable key), and
# Connect > Transaction pooler (DATABASE_URL, port 6543).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Google sign-in is configured in the Supabase dashboard (Authentication > Providers),
# not here. Locally, see [auth.external.google] in supabase/config.toml.

# Comma-separated emails that can open /admin (user counts, sign-ups)
ADMIN_EMAILS=

# --- PostHog (leave blank to disable analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ASSETS_HOST=https://us-assets.i.posthog.com

# --- AI drill debriefs (optional; falls back to built-in feedback) ---
# Set any ONE key. AI_PROVIDER picks one explicitly (anthropic | openai | gemini);
# when blank, the first provider with a key is used.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Any OpenAI-compatible API works too (OpenRouter, Groq, Together, Ollama...)
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
